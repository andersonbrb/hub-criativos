# Copie este arquivo para .env.local e preencha as chaves. O .env.local nunca vai para o git.
# Depois de editar, reinicie o servidor (npm run dev).
# No Railway estas variáveis ficam no serviço "hub" (veja docs/railway.md na raiz).

# --- Plataforma ---

# Banco Postgres (contas, convites, memória, conector). No Railway vem do serviço Postgres pela referência
# ${{Postgres.DATABASE_URL}}. No PC é opcional: sem ele, as telas novas não funcionam e o resto segue nos arquivos.
DATABASE_URL=

# Endereço público do hub, em HTTPS e sem barra no fim (ex.: https://hub-production-797d.up.railway.app).
# Os logins das integrações (ElevenLabs) e o conector do Claude dependem dele.
HUB_PUBLIC_URL=

# E-mails dos donos da plataforma (acesso total), separados por vírgula.
DONOS_DA_PLATAFORMA=

# Opcional: para onde o login do conector (Claude na web) pode voltar, separado por vírgula. O Claude Code no PC
# (http://localhost:<porta>/callback) vale sempre. Vazio usa os endereços do claude.ai e do claude.com.
MCP_REDIRECTS_PERMITIDOS=

# --- Google Drive (onde os vídeos gerados ficam guardados) ---
# Passo a passo em docs/google-drive.md (na raiz). Depois de preencher, conecte a conta em Integrações → Google Drive.

# Cliente OAuth "Aplicativo da Web" do Google Cloud. Sem os dois, o card do Drive mostra "Falta configurar".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Chave que cifra a autorização do Google guardada no banco: 32 bytes em base64. Gere uma vez com
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# e não troque depois: com outra chave, o Drive precisa ser conectado de novo. Sem ela, o hub não conecta o Drive.
HUB_CHAVE_SEGREDOS=

# --- Chat interno ---

# Cérebro do chat. Vazio: Claude Code logado neste PC (assinatura). "api": API da Anthropic com ANTHROPIC_API_KEY.
HUB_BRAIN=
# "off" desliga o chat e os agentes (no Railway, enquanto não houver chave da Anthropic).
HUB_CHAT=
# Modelo do modo "api" (padrão claude-opus-5-5; claude-sonnet-5-5 sai mais barato).
HUB_API_MODEL=

# Agentes — console.anthropic.com → API Keys (só no modo HUB_BRAIN=api)
ANTHROPIC_API_KEY=

# Modo Black do chat principal (modelo venice-uncensored) — venice.ai → Settings → API
VENICE_API_KEY=

# --- Integrações ---
# FLORA, HeyGen e ElevenLabs entram pelo login da conta, na tela Integrações (sem chave de API).

# Não usada hoje (o hub usa o login da conta em Integrações). Mantida para quando voltar a usar a API.
# Voz — elevenlabs.io → Developers → API Keys
ELEVENLABS_API_KEY=

# Não usada hoje (o hub usa o login da conta em Integrações). Mantida para quando voltar a usar a API.
# Avatar — app.heygen.com → Settings → API
HEYGEN_API_KEY=

# Não usada hoje (o hub usa o login da conta em Integrações). Mantida para quando voltar a usar a API.
# Canvas — app.flora.ai → Settings → API Keys (começa com ak_)
FLORA_API_KEY=
# Assinatura dos webhooks do FLORA (começa com whsec_)
FLORA_WEBHOOK_SECRET=
# Opcional: fixar workspace/projeto do FLORA (senão usa o primeiro workspace e cria o projeto "Claquete Hub")
FLORA_WORKSPACE_ID=
FLORA_PROJECT_ID=

# Higgsfield — chave da API (formato id:secret). Hoje o hub ainda usa a CLI logada (higgsfield auth login).
HIGGSFIELD_API_KEY=
# Opcional: caminho do executável, se não for encontrado automaticamente.
HIGGSFIELD_BIN=
