# Copie este arquivo para .env.local e preencha as chaves. O .env.local nunca vai para o git.
# Depois de editar, reinicie o servidor (npm run dev).

# Voz — elevenlabs.io → Developers → API Keys
ELEVENLABS_API_KEY=

# Avatar — app.heygen.com → Settings → API
HEYGEN_API_KEY=

# Canvas — app.flora.ai → Settings → API Keys (começa com ak_)
FLORA_API_KEY=
# Assinatura dos webhooks do FLORA (começa com whsec_)
FLORA_WEBHOOK_SECRET=
# Opcional: fixar workspace/projeto do FLORA (senão usa o primeiro workspace e cria o projeto "Claquete Hub")
FLORA_WORKSPACE_ID=
FLORA_PROJECT_ID=

# Agentes — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Modo Black do chat principal (modelo venice-uncensored) — venice.ai → Settings → API
VENICE_API_KEY=

# Higgsfield — chave da API (formato id:secret). Hoje o hub ainda usa a CLI logada (higgsfield auth login).
HIGGSFIELD_API_KEY=
# Opcional: caminho do executável, se não for encontrado automaticamente.
HIGGSFIELD_BIN=
